{
    "compilerOptions":  {
                            "target":  "ES2022",
                            "module":  "ESNext",
                            "moduleResolution":  "Bundler",
                            "strict":  true,
                            "jsx":  "react-jsx",
                            "skipLibCheck":  true,
                            "noEmit":  true,
                            "types":  [
                                          "node",
                                          "vite/client"
                                      ],
                            "baseUrl":  ".",
                            "paths":  {
                                          "@shared/*":  [
                                                            "shared/*"
                                                        ]
                                      },
                            "verbatimModuleSyntax":  true,
                            "erasableSyntaxOnly":  true,
                            "allowImportingTsExtensions":  true
                        },
    "include":  [
                    "server",
                    "shared",
                    "scripts",
                    "tests",
                    "web/src",
                    "*.ts"
                ]
}
