{
    "name": "turtle-soup",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24 <25"
    },
    "scripts": {
        "dev": "concurrently -k -n server,web \"node --watch --import ./scripts/register-ts.mjs server/index.ts\" \"vite\"",
        "build": "vite build --configLoader native && tsc -p tsconfig.json --noEmit",
        "start": "node --import ./scripts/register-ts.mjs server/index.ts",
        "test": "vitest run",
        "import:puzzles": "node --import ./scripts/register-ts.mjs scripts/import/run.ts",
        "jev:smoke": "node --import ./scripts/register-ts.mjs scripts/jev-smoke.ts",
        "typecheck": "tsc -p tsconfig.json --noEmit"
    },
    "dependencies": {
        "@mantine/core": "^7.17.8",
        "@mantine/hooks": "^7.17.8",
        "canvas-confetti": "^1.9.4",
        "dotenv": "^18.0.5",
        "express": "^5.2.1",
        "framer-motion": "^14.0.0",
        "lucide-react": "^1.51.0",
        "nanoid": "^6.0.1",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "socket.io": "^4.8.4",
        "socket.io-client": "^4.8.4",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@testing-library/react": "^16.3.3",
        "@types/canvas-confetti": "^1.9.0",
        "@types/express": "^5.0.6",
        "@types/node": "^24.19.1",
        "@types/react": "^18.3.31",
        "@types/react-dom": "^18.3.7",
        "@vitejs/plugin-react": "^6.1.1",
        "concurrently": "^10.0.5",
        "jsdom": "^30.1.1",
        "tsx": "^4.23.15",
        "typescript": "^5.9.3",
        "vite": "^8.3.2",
        "vitest": "^5.0.3"
    }
}
